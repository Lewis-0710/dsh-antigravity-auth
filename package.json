{
  "name": "dsh-antigravity-auth",
  "version": "0.1.0",
  "description": "Private, single-account, unofficial Antigravity OAuth capability bundle for DeepSeek Harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suntianc/dsh-antigravity-auth.git"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.cjs"
    },
    "./search": {
      "types": "./lib/types/search.d.ts",
      "default": "./lib/search.js"
    },
    "./image": {
      "types": "./lib/types/image.d.ts",
      "default": "./lib/image.js"
    },
    "./video": {
      "types": "./lib/types/video.d.ts",
      "default": "./lib/video.js"
    },
    "./rpc-contract": {
      "types": "./lib/types/rpc-contract.d.ts",
      "default": "./lib/rpc-contract.js"
    },
    "./wire-identity": {
      "types": "./lib/types/wire-identity.d.ts",
      "default": "./lib/wire-identity.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/*.cjs",
    "lib/*.cjs.map",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.host.json && tsc -p tsconfig.build.client.json && tsdown",
    "bundle": "tsdown",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build && pnpm run package:smoke && pnpm run publint",
    "lint": "oxlint src tests build scripts tsdown.config.ts vitest.config.ts",
    "package:smoke": "node scripts/package-smoke.mjs",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build",
    "publint": "publint",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@cortexkit/antigravity-auth-core": "2.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-host-apiproxy": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.7 <0.2.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@cortexkit/antigravity-auth-core": "2.1.0",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "jsdom": "29.1.1",
    "lightningcss": "^1.33.0",
    "oxlint": "1.76.0",
    "publint": "^0.3.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semver": "^7.8.5",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
